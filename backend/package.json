{
  "name": "realest8-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env.local src/index.ts",
    "dev:docker": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file=../.env.local src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@hono/zod-validator": "^0.5.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.11",
    "pg": "^8.14.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.18",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "5.9.3"
  }
}
